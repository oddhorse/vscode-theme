{
	"name": "theme-oddhorse",
	"displayName": "oddhorse theme",
	"description": "an odd + horse theme for vscode, in light and dark",
	"version": "3.0.0",
	"publisher": "oddhorse",
	"repository": "https://github.com/oddhorse/vscode-theme",
	"scripts": {
		"package": "vsce package",
		"publish": "vsce publish",
		"json": "node ./scripts/generate_json_support.js"
	},
	"engines": {
		"vscode": "^1.5.0"
	},
	"categories": [
		"Themes"
	],
	"keywords": [
		"bright",
		"fun",
		"pink"
	],
	"contributes": {
		"themes": [
			{
				"label": "oddhorse theme (dark)",
				"uiTheme": "vs-dark",
				"path": "/themes/oddhorse-dark-color-theme.json"
			},
			{
				"label": "oddhorse theme",
				"uiTheme": "vs",
				"path": "./themes/oddhorse-color-theme.json"
			}
		]
	},
	"icon": "icon.png",
	"devDependencies": {
		"@vscode/vsce": "^4.0.0"
	}
}